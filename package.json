{
  "name": "zuugroup-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --hostname 0.0.0.0 --port 5000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 5000",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "recover:admin": "node scripts/recover-admin.mjs",
    "seed:products": "node scripts/seed-product-master.mjs",
    "seed:records": "node scripts/seed-operational-data.mjs"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
