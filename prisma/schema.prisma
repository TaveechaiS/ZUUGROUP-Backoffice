model SalesTerritory {
  manager User? @relation("TerritoryManager",fields:[managerId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  sales User? @relation("TerritorySales",fields:[salesId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  orders SalesOrder[] @relation("OrderTerritory")
  managerId String? @unique @map("manager_id") @db.Uuid
  salesId String? @unique @map("sales_id") @db.Uuid
  customerRecords Customer[]
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique
  name String @default("")
  status String @default("ใช้งานอยู่")
  area String @default("")
  owner String @default("")
