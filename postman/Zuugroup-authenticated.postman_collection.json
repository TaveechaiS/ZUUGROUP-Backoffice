      "name": "เข้าสู่ระบบ",
      "item": [
        {
          "name": "POST เข้าสู่ระบบ (Admin)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@zuugroup.com\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "POST {email,password}; ไม่ต้องมี token ก่อนล็อกอิน. สำเร็จ {ok,user,accessToken,tokenType,expiresIn}; error เป็น {error:string}. เก็บรหัสและ token ใน Environment ส่วนตัว.\nTASK-074: collection query view=filters/options/config; include ขอ metadata พร้อมรายการตามโมดูล; DELETE ลบเชิงตรรกะ; PATCH action restore กู้คืน."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  if (!pm.environment || !pm.environment.get('loginPassword')) throw new Error('กรุณาเลือก Environment ส่วนตัวและตั้ง loginPassword ก่อน');",
                  "  const data = pm.response.json();",
                  "  if (data.tokenType !== 'Bearer' || !data.accessToken) throw new Error('ไม่พบ access token');",
                  "  pm.environment.set('adminToken', data.accessToken);",
                  "  pm.environment.set('activeToken', data.accessToken);",
                  "} else if (pm.environment) {",
                  "  pm.environment.unset('activeToken');",
                  "}"
                ]
              }
            }
          ]
        },
