{
  "info": {
    "name": "Zuugroup — Authenticated",
    "description": "ส่ง POST ของบัญชีที่ต้องการเพื่อรับ access token ลง Environment ส่วนตัว แล้ว GET ใช้ Bearer {{activeToken}}; อย่าแชร์ Environment ที่มี token หรือรหัสผ่าน",
    "schema": "https://schema.postman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "เข้าสู่ระบบ",
      "item": [
        {
          "name": "POST เข้าสู่ระบบ (Admin)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@zuugroup.com\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "สำเร็จเก็บ access token ใน adminToken และ activeToken ของ Environment ส่วนตัว"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  if (!pm.environment || !pm.environment.get('loginPassword')) throw new Error('กรุณาเลือก Environment ส่วนตัวและตั้ง loginPassword ก่อน');",
                  "  const data = pm.response.json();",
                  "  if (data.tokenType !== 'Bearer' || !data.accessToken) throw new Error('ไม่พบ access token');",
                  "  pm.environment.set('adminToken', data.accessToken);",
                  "  pm.environment.set('activeToken', data.accessToken);",
                  "} else if (pm.environment) {",
                  "  pm.environment.unset('activeToken');",
                  "}"
                ]
              }
            }
          ]
        },
