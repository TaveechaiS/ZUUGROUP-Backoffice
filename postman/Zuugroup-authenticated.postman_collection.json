    {
      "name": "Supabase Data API (อ่านตรง)",
      "description": "ใช้ publishable key และ JWT ของผู้ใช้; ตารางสินค้าใน DB ปัจจุบันยังไม่เปิด GRANT/RLS สำหรับ Data API จึงอาจตอบ 403/42501 ห้ามใช้ secret key แทน",
      "item": [
        {
          "name": "GET หมวดสินค้า",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "apikey",
                "value": "{{supabasePublishableKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{activeToken}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{supabaseUrl}}/rest/v1/product_categories?select=id,code,name&order=code.asc&limit=50",
