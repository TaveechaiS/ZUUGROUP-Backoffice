# Environment: local development only; copy to .env.local and fill credentials there.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://wiikzseotpjxssbcdayk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Runtime connection: use the Session Pooler string from Supabase Dashboard > Connect.
# Replace placeholders locally; URL-encode reserved characters in the password.
DATABASE_URL=postgresql://postgres.wiikzseotpjxssbcdayk:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require

# Prisma CLI/migrations: use the Direct connection string from Dashboard > Connect.
# Direct connections may require IPv6. If unavailable, use Session Pooler for local development.
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.wiikzseotpjxssbcdayk.supabase.co:5432/postgres?sslmode=require
